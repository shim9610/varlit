+/// A header is only a rejection hint. Growth beyond one zstd block requires
+/// the decoder to have exhausted the previous destination. Bulk decoding uses
+/// the destination as history, so an untrusted window cannot move the same
+/// speculative allocation into zstd's streaming history buffer.
+#[cfg(feature = "compression-zstd")]
+fn decode_growing(
+    context: &mut zstd::zstd_safe::DCtx<'_>,
+    payload: &[u8],
+    output: &mut Vec<u8>,
+    maximum: usize,
+    exact: bool,
+) -> Result<usize> {
+    let declared = frame_output_len(payload);
+    if let Some(actual) = declared
+        && (actual > maximum as u64 || (exact && actual != maximum as u64))
+    {
+        return Err(Error::DecompressedLengthMismatch {
+            expected: maximum as u64,
+            actual,
+        });
+    }
+    let limit = declared.map_or(maximum, |n| n as usize);
+    let start = output.len();
+    let mut size = output
+        .capacity()
+        .saturating_sub(start)
+        .min(limit)
+        .max(limit.min(128 * 1024));
+    loop {
+        let end = start.checked_add(size).ok_or(Error::InvalidChunkedBytes)?;
+        output
+            .try_reserve_exact(end - output.len())
+            .map_err(|_| Error::AllocationFailed {
+                resource: "decompressed payload",
+                requested: end as u64,
+            })?;
+        // Slice destinations enforce the caller's limit even when an allocator
+        // supplies extra capacity. Keep the prefix intact on failed attempts.
+        let decoded = if declared.is_some() {
+            // Known frame sizes bound the backend's result, including when a
+            // reusable allocation has spare capacity. Cursor exposes only
+            // bytes initialized by the backend, avoiding a redundant zero fill.
+            let mut tail = std::io::Cursor::new(&mut *output);
+            tail.set_position(start as u64);
+            context.decompress(&mut tail, payload)
+        } else {
+            output.resize(end, 0);
+            context.decompress(&mut output[start..end], payload)
+        };
+        match decoded {
+            Ok(written) => {
+                output.truncate(start + written);
+                if exact && written != maximum {
+                    return Err(Error::DecompressedLengthMismatch {
+                        expected: maximum as u64,
+                        actual: written as u64,
+                    });
