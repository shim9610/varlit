{
  "contracts": [
    {
      "id": "record-extent",
      "harnesses": [
        "file::record_extent_proofs::checked_extent_matches_wide_arithmetic"
      ],
      "sources": [
        "crates/varlit-core/src/verification/record_extent.rs",
        "crates/varlit-core/src/file.rs"
      ],
      "scope": "full-width arithmetic",
      "limits": "No filesystem or allocation model"
    },
    {
      "id": "observed-prefix",
      "harnesses": [
        "file::resident_index::uniform_prefix_proofs::observed_prefix_never_invents_membership",
        "file::resident_index::uniform_prefix_proofs::full_width_prefix_initialization_establishes_invariant",
        "file::resident_index::uniform_prefix_proofs::full_width_prefix_observation_preserves_invariant",
        "file::resident_index::uniform_prefix_proofs::full_width_bounded_prefix_truncation_only_removes_rows"
      ],
      "sources": [
        "crates/varlit-core/src/verification/uniform_prefix.rs",
        "crates/varlit-core/src/native_directory.rs"
      ],
      "scope": "full-width inductive range/observation transition; truncation up to four rows; four-row u16 membership",
      "limits": "General count*stride representation induction timed out and is not proved; internal row indices must be representable. No whole-caller refinement."
    },
    {
      "id": "publication-metadata",
      "harnesses": [
        "disk_index::publication_proofs::accepted_metadata_has_consistent_publication_frontiers",
        "disk_index::publication_proofs::valid_clean_frontiers_are_not_rejected",
        "disk_index::publication_proofs::restore_cannot_change_the_confirmed_frontier",
        "disk_index::publication_proofs::valid_checkpoint_restore_is_not_rejected"
      ],
      "sources": [
        "crates/varlit-core/src/disk_index/publication_proofs.rs",
        "crates/varlit-core/src/disk_index.rs"
      ],
      "scope": "full-width typed metadata",
      "limits": "Raw byte parsing and OS ordering excluded"
    },
    {
      "id": "publication-protocol",
      "harnesses": [
        "publication_protocol::proofs::commit_survives_every_io_failure_effect",
        "publication_protocol::proofs::successful_commit_is_reachable_and_durable",
        "publication_protocol::proofs::nonconfirmed_publications_do_not_use_a_second_head",
        "publication_protocol::proofs::recovery_never_publishes_before_truncate_and_sync",
        "publication_protocol::proofs::follow_error_preserves_the_entire_reader",
        "publication_protocol::proofs::frontier_invariant_is_preserved_by_an_arbitrary_transition",
        "publication_protocol::proofs::initial_frontier_satisfies_the_inductive_invariant",
        "publication_protocol::proofs::poisoned_writer_never_reaches_publication",
        "publication_protocol::proofs::resumed_writer_cannot_acknowledge_a_volatile_head"
      ],
      "sources": [
        "crates/varlit-core/src/publication_protocol/proofs.rs",
        "crates/varlit-core/src/publication_protocol.rs"
      ],
      "scope": "abstract I/O effects and inductive frontiers",
      "limits": "Callbacks, fsync durability and stable snapshots assumed; creation/replacement not modeled"
    },
    {
      "id": "compression-steps",
      "harnesses": [
        "compression_buffers::resource_steps::proofs::output_requests_respect_both_limits",
        "compression_buffers::resource_steps::proofs::arbitrary_block_step_progresses_or_rejects"
      ],
      "sources": [
        "crates/varlit-core/src/verification/compression.rs",
        "crates/varlit-core/src/compression_steps.rs",
        "crates/varlit-core/src/compression_buffers.rs"
      ],
      "scope": "full-width progress and reservation arithmetic",
      "limits": "C zstd decoding/workspace and legacy parsing excluded"
    },
    {
      "id": "limited-spill",
      "harnesses": [
        "spill_file::proofs::limited_writes_preserve_progress_across_failure_and_retry",
        "spill_file::proofs::valid_limited_writes_are_not_rejected"
      ],
      "sources": [
        "crates/varlit-core/src/verification/spill.rs",
        "crates/varlit-core/src/spill_file.rs"
      ],
      "scope": "full-width offsets, at most four bytes and one Interrupted",
      "limits": "Write returns n <= requested; unending Interrupted and OS liveness excluded"
    },
    {
      "id": "chunk-parser",
      "harnesses": [
        "chunks::resource_proofs::full_width_chunk_table_bounds_iteration_by_real_input",
        "chunks::resource_proofs::arbitrary_chunk_entry_bytes_are_checked",
        "chunks::resource_proofs::full_width_chunk_header_fields_are_validated"
      ],
      "sources": [
        "crates/varlit-core/src/verification/chunks.rs",
        "crates/varlit-core/src/chunks.rs"
      ],
      "scope": "full-width actual table extent plus arbitrary header fields and entry bytes",
      "limits": "Whole 0..96-byte parser attempts timed out. Loop count derives from validated actual input extent; complete raw parser covered by native corpus/fuzzing, not a whole-parser proof."
    },
    {
      "id": "materialization",
      "harnesses": [
        "collections::resource_proofs::cumulative_materialization_never_wraps_or_replenishes"
      ],
      "sources": [
        "crates/varlit-core/src/verification/materialization.rs",
        "crates/varlit-core/src/collections.rs"
      ],
      "scope": "full-width inductive budget step",
      "limits": "Budget reset requires prior record release; not a whole-process live-memory bound"
    },
    {
      "id": "index-visits",
      "harnesses": [
        "disk_index::tree::resource_proofs::every_node_visit_consumes_finite_fuel",
        "disk_index::tree::resource_proofs::accepted_child_height_strictly_decreases"
      ],
      "sources": [
        "crates/varlit-core/src/verification/traversal.rs",
        "crates/varlit-core/src/disk_index/tree.rs"
      ],
      "scope": "full-width decreasing fuel",
      "limits": "Binding guard plus real CRC-valid hostile index tests; callbacks and node parser not formally refined"
    },
    {
      "id": "decoder-memory",
      "harnesses": [
        "codec::resource_proofs::full_width_decoder_charge_preserves_budget_on_failure",
        "codec::resource_proofs::full_width_collection_preflight_bounds_zero_width_work",
        "codec::resource_proofs::input_cursor_advances_exactly_or_stays_unchanged",
        "codec::resource_proofs::nested_failure_cannot_refund_a_successful_charge",
        "codec::resource_proofs::retained_sibling_decodes_share_one_budget_even_after_errors",
        "codec::resource_proofs::hashmap_preflight_accounts_for_overlapping_tables"
      ],
      "sources": [
        "crates/varlit-core/src/codec.rs",
        "crates/varlit-core/src/verification/decoder.rs"
      ],
      "scope": "full-width charge/count arithmetic; 64-byte cursor/preflight input; actual nested/accounted transfer with a returning charged callback; two-table HashMap reservation accounting",
      "limits": "BTreeMap excluded. Does not model actual allocator/hashbrown/C allocation or arbitrary custom codecs. Hash table layout bound assumes the documented supported std layout. No global process OOM claim."
    }
  ]
}
